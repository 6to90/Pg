# Copy to .env (never commit .env). Only testnet configuration is accepted.
APP_ENV=local                 # local | testnet
PRODUCT_NAME=6to9 Crypto Payment Gateway
DATABASE_URL=postgres://gw_app:CHANGE_ME@127.0.0.1:5432/gw_dev
# Integration tests only; the database name must end in _test.
TEST_DATABASE_URL=postgres://gw_app:CHANGE_ME@127.0.0.1:5432/gw_test
CHAIN_ID=31337                # 31337 (local anvil) or 84532 (Base Sepolia); anything else is rejected
RPC_URL=http://127.0.0.1:8545 # testnet requires https
CONFIRMATIONS=12              # configurable; a block count is not a finality guarantee
LOG_LEVEL=info
